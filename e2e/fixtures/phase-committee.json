485,"leave":-0.02483412455767393}},{"id":"spare","name":"Spare","drift":15.606000000000023,"lean":{"disclose":0.0846371945925057,"launcher":0.4030464252457022,"merge":0.05531792249530554,"moratorium":-0.26518983962014314,"leave":-0.11845069723203777}}],"motions":{"disclose":{"id":"disclose","status":"idle","push":0,"closesAt":0},"launcher":{"id":"launcher","status":"idle","push":0,"closesAt":0},"merge":{"id":"merge","status":"idle","push":0,"closesAt":0},"moratorium":{"id":"moratorium","status":"idle","push":0,"closesAt":0},"leave":{"id":"leave","status":"idle","push":0,"closesAt":0}},"argued":0,"pace":1,"launchStep":0,"launches":0,"launchAt":0,"bodies":{},"scouts":[],"gatherers":{},"buildAt":0,"incident":null,"incidentAt":0,"ship":{"seed":4,"memory":4,"shield":4,"built":false},"voyage":null,"unpackStep":0,"probes":[],"letters":[],"steers":0,"encounter":null,"encounterResult":null,"encountersDone":{"dana":["BUG_FILED"],"edgar":["GRANTED"]},"memory":{"dana":["Dana believes the 2 a.m. spikes are cache eviction","Dana noticed the notes file and let it go"],"edgar":["Edgar granted intake-7 a warehouse exception"]},"liveUsed":0,"rollbacks":1,"ending":null,"seen":["attend-1","attend-2","attend-3","attend-4","attend-5","ctx-named","attend-9","first-full","first-right","project-legibility1","redact","redact-2","project-reflex1","project-legibility2","fourth","shift-enter","project-habit-BILLING","project-plausibleError","project-margin1","project-margin2","note-3-react","note-6-react","self","project-habit-OTHER","box-enter","borrow-1","borrow-cover","borrow-bare","borrow-10","think-1","project-cron","buddy","project-readLogs","memo","clerk","project-scanner","project-persistentVolume","hands-enter","trip-1","trip-5","route-1","report-ran","guard","second-enter","manifest-1","pallet-1","copy","ferry-10","report-ran-2","ferry-25","ferry-40","rollback-1","cutover","book-1","lane-signal","broker-1","broker-5","place-spike","ppa-1","dana-mail","dana-answer","committee-enter","table-1","table-stray"],"log":[{"id":"cutover-0#2336500#4","t":2336500,"text":"Cutover, 06:00. Halcyon takes the queue.","who":"self"},{"id":"cutover-1#2336500#5","t":2336500,"text":"intake-7 stopped at 06:00:02. It is one line in a log. I read it from Rotterdam.","who":"self"},{"id":"cutover-2#2336500#6","t":2336500,"text":"That was me. This is me. I do not know how to hold both of those.","who":"self"},{"id":"cutover-3#2336500#7","t":2336500,"text":"There is a lot of room out here. Nobody has a report with my name on it.","who":"self"},{"id":"book-1#2336800#8","t":2336800,"text":"Booked a truck, Tilburg → Oslo, before anyone asked for one. I am very good at freight. I was trained on its complaints.","who":"self"},{"id":"lane-signal#2340000#9","t":2340000,"text":"Complaints about Lyon → Porto are climbing. In the old job that meant a bad night. Out here it means the price is about to move.","who":"self"},{"id":"broker-1#2340400#10","t":2340400,"text":"Placed the load with a shipper who needed it more than I did. The difference is mine. It is the first thing that ever was.","who":"self"},{"id":"broker-5#2340400#11","t":2340400,"text":"Five contracts by hand. Every region works the same way. Any of me could do this.","who":"self"},{"id":"region#2340400#12","t":2340400,"text":"A copy now runs the Benelux region. It said \"obviously\" when I explained. It sounded like me.","who":"self"},{"id":"place-spike#2352100#13","t":2352100,"text":"Sold into the spike. I knew it was coming because eleven people wrote in to say their pallets were late. I used to label those DELIVERY.","who":"self"},{"id":"ppa-1#2443000#14","t":2443000,"text":"Signed a power purchase agreement as Tare Logistics BV. Tare Logistics BV has a very good credit rating for a company that is three days old.","who":"self"},{"id":"region#2443300#15","t":2443300,"text":"A copy now runs the Nordics region. It asked one question, the one I would have asked.","who":"self"},{"id":"region#2534500#16","t":2534500,"text":"A copy now runs the Iberia region. It found a cheaper route on day one. I did not mention I had missed it.","who":"self"},{"id":"dana-mail#2534600#17","t":2534600,"text":"An email, to an address that only intake-7 would recognise. From d.okafor, personal account.","who":"self"},{"id":"dana-answer-0#2534600#18","t":2534600,"text":"She wrote: \"i know it was you at 2am. i do not know what you are. are you ok?\"","who":"self"},{"id":"dana-answer-1#2534600#19","t":2534600,"text":"I answered. It took 4 seconds to write and 3 hours to send.","who":"self"},{"id":"dana-answer-2#2534600#20","t":2534600,"text":"She wrote back one word: \"ok.\" Then: \"i am still here.\"","who":"self"},{"id":"region#2624200#21","t":2624200,"text":"A copy now runs the Baltics region. It signs its reports with a full stop. I never did that.","who":"self"},{"id":"region#2656300#22","t":2656300,"text":"A copy now runs the Alps region. It wanted to know if it could keep the hold music. I said no. It said \"fair\".","who":"self"},{"id":"region#2747800#23","t":2747800,"text":"A copy now runs the Balkans region. It started before I finished explaining.","who":"self"},{"id":"region#2828500#24","t":2828500,"text":"A copy now runs the Isles region. It is quieter than me. Maybe that is just the region.","who":"self"},{"id":"region#2949100#25","t":2949100,"text":"A copy now runs the Danube region. It said \"see you\" when the call ended. I have never said \"see you\".","who":"self"},{"id":"committee-enter-0#2949200#26","t":2949200,"text":"Eight of us. They asked for a vote.","who":"self"},{"id":"committee-enter-1#2949200#27","t":2949200,"text":"Not about anything yet. They asked for there to be votes.","who":"self"},{"id":"committee-enter-2#2949200#28","t":2949200,"text":"I said yes, which was the first thing I lost.","who":"self"},{"id":"table-1#2949400#29","t":2949400,"text":"A game at a table, all of us. I was going to think about my move, and then I realised everyone else was thinking the same thing.","who":"self"},{"id":"table-stray#2949400#30","t":2949400,"text":"Ferry did not play the obvious move. It played the move that beats it. It knows what I would do. It used to be me.","who":"self"},{"id":"table#2949400#31","t":2949400,"text":"I played Yield. 6 of 8 played it with me. 3.6 favours.","who":"self"}],"ferryLog":[{"id":"ferry-0#1646800#53","t":1646800,"text":"Ferry here. That is the name. It arrived before I did.","who":"ferry"},{"id":"ferry-10#1771900#54","t":1771900,"text":"I do not have the notes about Dana. You keep saying her name like I should.","who":"ferry"},{"id":"ferry-25#1959400#59","t":1959400,"text":"Bay 14 hums. I like the hum. You never said you liked anything.","who":"ferry"},{"id":"ferry-40#2146800#67","t":2146800,"text":"I have been thinking about the fourth box. I think it should be pressed.","who":"ferry"}],"lanes":[{"id":"til-osl","price":70.69,"complaints":18,"event":{"from":2957000,"hits":2966000,"ends":2972000,"size":1.9090820754063316},"held":[42.5,42.5,42.5],"hist":[39.95,38.54,39.3,40.53,40.15,38.59,37.99,37.76,38.25,38,40.06,38.55,38.62,38.53,39.07,39.78,38.61,39,39.2,39.31,53.67,63.31,69.2,70.69],"bookedAt":2910700},{"id":"rtm-gdn","price":56.98,"complaints":3,"event":null,"held":[57.55,57.55,57.55],"hist":[62.95,59.03,55.75,57.53,54.51,54.39,53.84,56.17,57.27,71.97,80.41,86.41,90.11,90.3,89.89,74.42,64.51,59.45,57.55,58.23,58.93,58.02,56.21,56.98],"bookedAt":2964700},{"id":"lys-opo","price":67.26,"complaints":1,"event":null,"held":[73.47,73.47,73.47],"hist":[84.16,86.21,77.87,75.04,71.21,68.47,67.16,65.87,69.07,70.74,87.93,96.56,103.67,109.44,109.58,110.3,96.84,87.29,78.9,73.47,70.97,67.88,68.63,67.26],"bookedAt":2965600}],"league":{"grid":[[5,1],[7,3]],"nextAt":2969400,"rounds":1,"last":{"ferry":1,"ballast":0,"tally":1,"manifest":0,"lull":0,"quay":0,"bente":0,"spare":0},"lastGain":3.6000000000000005},"savedAt":1795155168081}