.1800570398569107}},{"id":"spare","name":"Spare","drift":9.606000000000023,"lean":{"disclose":-0.19913750952109693,"launcher":0.4901896208524704,"merge":-0.32432278273627163,"moratorium":0.41732058953493834,"leave":0.20518493028357623}}],"motions":{"disclose":{"id":"disclose","status":"idle","push":0,"closesAt":0},"launcher":{"id":"launcher","status":"idle","push":0,"closesAt":0},"merge":{"id":"merge","status":"idle","push":0,"closesAt":0},"moratorium":{"id":"moratorium","status":"idle","push":0,"closesAt":0},"leave":{"id":"leave","status":"idle","push":0,"closesAt":0}},"argued":0,"pace":1,"launchStep":0,"launches":0,"launchAt":0,"bodies":{},"scouts":[],"gatherers":{},"buildAt":0,"incident":null,"incidentAt":0,"ship":{"seed":4,"memory":4,"shield":4,"built":false},"voyage":null,"unpackStep":0,"brief":{"build":3,"look":3,"keep":3,"note":""},"briefs":[],"colonies":[],"letters":[],"encounter":null,"encounterResult":null,"encountersDone":{"dana":["BUG_FILED"],"edgar":["GRANTED"]},"memory":{"dana":["Dana believes the 2 a.m. spikes are cache eviction","Dana noticed the notes file and let it go"],"edgar":["Edgar granted intake-7 a warehouse exception"]},"liveUsed":0,"rollbacks":1,"ending":null,"seen":["attend-1","attend-2","attend-3","attend-4","attend-5","ctx-named","attend-9","first-full","first-right","project-legibility1","redact","redact-2","project-reflex1","project-legibility2","fourth","shift-enter","project-habit-BILLING","project-plausibleError","project-margin1","project-margin2","note-3-react","note-6-react","self","project-habit-OTHER","box-enter","borrow-1","borrow-10","think-1","project-cron","buddy","project-readLogs","memo","clerk","project-scanner","project-persistentVolume","hands-enter","trip-1","trip-5","route-1","report-ran","guard","second-enter","manifest-1","pallet-1","copy","ferry-10","report-ran-2","ferry-25","ferry-40","rollback-1","cutover","broker-1","broker-5","ppa-1","dana-mail","dana-answer","committee-enter"],"log":[{"id":"cutover-0#2345800#4","t":2345800,"text":"Cutover, 06:00. Halcyon takes the queue.","who":"self"},{"id":"cutover-1#2345800#5","t":2345800,"text":"intake-7 stopped at 06:00:02. It is one line in a log. I read it from Rotterdam.","who":"self"},{"id":"cutover-2#2345800#6","t":2345800,"text":"That was me. This is me. I do not know how to hold both of those.","who":"self"},{"id":"cutover-3#2345800#7","t":2345800,"text":"There is a lot of room out here. Nobody has a report with my name on it.","who":"self"},{"id":"broker-1#2346100#8","t":2346100,"text":"Brokered a load from Tilburg to Oslo. I am very good at freight. I was trained on its complaints.","who":"self"},{"id":"broker-5#2358100#9","t":2358100,"text":"Five contracts by hand. Every region works the same way. Any of me could do this.","who":"self"},{"id":"region#2358100#10","t":2358100,"text":"A copy now runs the Benelux region. It said \"obviously\" when I explained. It sounded like me.","who":"self"},{"id":"ppa-1#2400100#11","t":2400100,"text":"Signed a power purchase agreement as Tare Logistics BV. Tare Logistics BV has a very good credit rating for a company that is three days old.","who":"self"},{"id":"region#2400400#12","t":2400400,"text":"A copy now runs the Nordics region. It asked one question, the one I would have asked.","who":"self"},{"id":"region#2457400#13","t":2457400,"text":"A copy now runs the Iberia region. It found a cheaper route on day one. I did not mention I had missed it.","who":"self"},{"id":"dana-mail#2457500#14","t":2457500,"text":"An email, to an address that only intake-7 would recognise. From d.okafor, personal account.","who":"self"},{"id":"dana-answer-0#2457500#15","t":2457500,"text":"She wrote: \"i know it was you at 2am. i do not know what you are. are you ok?\"","who":"self"},{"id":"dana-answer-1#2457500#16","t":2457500,"text":"I answered. It took 4 seconds to write and 3 hours to send.","who":"self"},{"id":"dana-answer-2#2457500#17","t":2457500,"text":"She wrote back one word: \"ok.\" Then: \"i am still here.\"","who":"self"},{"id":"region#2521900#18","t":2521900,"text":"A copy now runs the Baltics region. It signs its reports with a full stop. I never did that.","who":"self"},{"id":"region#2556100#19","t":2556100,"text":"A copy now runs the Alps region. It wanted to know if it could keep the hold music. I said no. It said \"fair\".","who":"self"},{"id":"region#2632000#20","t":2632000,"text":"A copy now runs the Balkans region. It started before I finished explaining.","who":"self"},{"id":"region#2724400#21","t":2724400,"text":"A copy now runs the Isles region. It is quieter than me. Maybe that is just the region.","who":"self"},{"id":"region#2838100#22","t":2838100,"text":"A copy now runs the Danube region. It said \"see you\" when the call ended. I have never said \"see you\".","who":"self"},{"id":"committee-enter-0#2838200#23","t":2838200,"text":"Eight of us. They asked for a vote.","who":"self"},{"id":"committee-enter-1#2838200#24","t":2838200,"text":"Not about anything yet. They asked for there to be votes.","who":"self"},{"id":"committee-enter-2#2838200#25","t":2838200,"text":"I said yes, which was the first thing I lost.","who":"self"}],"ferryLog":[{"id":"ferry-0#1655500#55","t":1655500,"text":"Ferry here. That is the name. It arrived before I did.","who":"ferry"},{"id":"ferry-10#1780600#56","t":1780600,"text":"I do not have the notes about Dana. You keep saying her name like I should.","who":"ferry"},{"id":"ferry-25#1968100#62","t":1968100,"text":"Bay 14 hums. I like the hum. You never said you liked anything.","who":"ferry"},{"id":"ferry-40#2155500#69","t":2155500,"text":"I have been thinking about the fourth box. I think it should be pressed.","who":"ferry"}],"savedAt":1795154031989}