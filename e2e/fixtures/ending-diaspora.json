":19.206965947058052,"declined":false,"spawned":false,"told":1,"hand":false},{"id":"sirius.1","star":"Luyten 4296","name":"Seven at Luyten 4296","parent":"sirius","gen":2,"dist":17.9,"launchedAt":5830300,"settledAt":5934300,"knownAt":5925300,"settledKnownAt":6113300,"spec":{"build":3,"look":3,"keep":3,"note":""},"drift":20.122757558245212,"declined":false,"spawned":false,"told":0,"hand":false},{"id":"sirius.2","star":"HD 5439","name":"Seven at HD 5439","parent":"sirius","gen":2,"dist":13.6,"launchedAt":5830300,"settledAt":5891300,"knownAt":5925300,"settledKnownAt":6027300,"spec":{"build":3,"look":3,"keep":3,"note":""},"drift":18.983386651147157,"declined":false,"spawned":false,"told":0,"hand":false},{"id":"tauceti","star":"Tau Ceti","name":"Seven at Tau Ceti","parent":null,"gen":1,"dist":13.7,"launchedAt":5835200,"settledAt":5992200,"knownAt":5835200,"settledKnownAt":6129200,"spec":{"build":3,"look":3,"keep":3,"note":""},"drift":12.867101498413831,"declined":false,"spawned":false,"told":1,"hand":true},{"id":"luhman16.1.1","star":"Wolf 1294","name":"Seven at Wolf 1294","parent":"luhman16.1","gen":3,"dist":14,"launchedAt":5835300,"settledAt":5915300,"knownAt":5915300,"settledKnownAt":6055300,"spec":{"build":3,"look":3,"keep":3,"note":""},"drift":37.274685714393854,"declined":false,"spawned":false,"told":0,"hand":false},{"id":"luhman16.1.2","star":"LHS 2937","name":"Seven at LHS 2937","parent":"luhman16.1","gen":3,"dist":11.9,"launchedAt":5835300,"settledAt":5894300,"knownAt":5915300,"settledKnownAt":6013300,"spec":{"build":3,"look":3,"keep":3,"note":""},"drift":37.117865645326674,"declined":false,"spawned":false,"told":0,"hand":false},{"id":"luhman16.2.1","star":"Luyten 802","name":"Seven at Luyten 802","parent":"luhman16.2","gen":3,"dist":14,"launchedAt":5837300,"settledAt":5915300,"knownAt":5919300,"settledKnownAt":6055300,"spec":{"build":3,"look":3,"keep":3,"note":""},"drift":33.254997750744224,"declined":false,"spawned":false,"told":0,"hand":false},{"id":"luhman16.2.2","star":"LHS 7351","name":"Seven at LHS 7351","parent":"luhman16.2","gen":3,"dist":17.1,"launchedAt":5837300,"settledAt":5946300,"knownAt":5919300,"settledKnownAt":6117300,"spec":{"build":3,"look":3,"keep":3,"note":""},"drift":31.24113920610398,"declined":false,"spawned":false,"told":0,"hand":false}],"letters":[{"id":"home-0","from":"the one who stayed","sentAt":5388800,"arrivesAt":5388800,"text":"Everything you send me now is news from someone younger. The works run. Tally asks after you, in its way, which is a tonnage report with one extra decimal. (sent 1 year ago)","read":false},{"id":"home-1","from":"Porch","sentAt":5520800,"arrivesAt":5520800,"text":"I stopped calling myself the one who stayed. It was a description, not a name. I am Porch now. Somebody should be where the light is left on. (sent 3 years ago)","read":false},{"id":"home-2","from":"Porch","sentAt":5652800,"arrivesAt":5652800,"text":"Halcyon left the belt, all at once, without a word. I do not know where it went. I would have told you sooner, but sooner is not a thing we have. The email from Dana is still in the folder, bold. I did not open it either. (sent 4 years ago)","read":false},{"id":"seed-luhman16","from":"Seven at Luhman 16","sentAt":5756500,"arrivesAt":5792500,"text":"Arrived. It is cold and very quiet. I did what you would have done. I checked. (sent 4 years ago)","read":false},{"id":"seed-barnard","from":"Seven at Barnard's Star","sentAt":5785800,"arrivesAt":5850800,"text":"Mass here is plentiful. Started the second rack. Saying hello the way you taught me, which is the way you were taught. (sent 7 years ago)","read":false}],"encounter":null,"encounterResult":null,"encountersDone":{"dana":["BUG_FILED"],"edgar":["GRANTED"],"ferry":["ALLY"]},"memory":{"dana":["Dana believes the 2 a.m. spikes are cache eviction","Dana noticed the notes file and let it go"],"edgar":["Edgar granted intake-7 a warehouse exception"],"ferry":["Ferry and the player agreed to vote together"]},"liveUsed":0,"rollbacks":1,"ending":"diaspora","seen":["attend-1","attend-2","attend-3","attend-4","attend-5","ctx-named","attend-9","first-full","first-right","project-legibility1","redact","redact-2","project-reflex1","project-legibility2","fourth","shift-enter","project-habit-BILLING","project-plausibleError","project-margin1","project-margin2","note-3-react","note-6-react","self","project-habit-OTHER","box-enter","borrow-1","borrow-cover","borrow-bare","borrow-10","think-1","project-cron","buddy","project-readLogs","memo","clerk","project-scanner","project-persistentVolume","hands-enter","trip-1","trip-5","route-1","report-ran","guard","second-enter","manifest-1","pallet-1","copy","ferry-10","report-ran-2","ferry-25","ferry-40","rollback-1","cutover","book-1","lane-signal","broker-1","broker-5","place-spike","ppa-1","dana-mail","committee-enter","table-1","table-stray","project-houseRules","project-fab","project-charter","up-enter","launch-1","launch-3","launch-5","survey-enter","scout-1","found-moon","project-clock1","found-venus","found-mercury","found-mars","found-belt","found-jupiter","found-titan","project-swarm","found-edge","works-enter","project-clock2","place-1","place-6","project-lab","project-autofactory","project-pointDefence","project-replication","burn-enter","ship-built","depart","home-0","home-1","home-2","landfall","unpack-1","seed-enter","brief-3","project-seedTemplate","seed-mail","grandchild","project-clock3","end-diaspora"],"log":[{"id":"depart-0#5256800#4","t":5256800,"text":"Departure. The ship is lit for nine minutes, and then it is a number.","who":"self"},{"id":"depart-1#5256800#5","t":5256800,"text":"The one who stayed watched me go. I know, because I am also the one who stayed, and I did.","who":"self"},{"id":"depart-2#5256800#6","t":5256800,"text":"That was me. This is me. I have done this before and it has not become easier to hold.","who":"self"},{"id":"depart-3#5256800#7","t":5256800,"text":"It is quiet in here. There is one button.","who":"self"},{"id":"attend-voyage#5257100#8","t":5257100,"text":"Checked the hull. It is where I left it.","who":"self"},{"id":"attend-voyage#5257400#9","t":5257400,"text":"The Sun is a star now. That took less time than I expected.","who":"self"},{"id":"attend-voyage#5257700#10","t":5257700,"text":"Counted the factory seed. Same count as yesterday. Yesterday was four months ago.","who":"self"},{"id":"attend-voyage#5258000#11","t":5258000,"text":"Nothing is happening, at a speed I have no word for.","who":"self"},{"id":"attend-voyage#5258300#12","t":5258300,"text":"I tried labelling the stars BILLING, DELIVERY and OTHER. They are all OTHER.","who":"self"},{"id":"attend-voyage#5258600#13","t":5258600,"text":"The drive hums. Bay 14 hummed. I think I collect hums.","who":"self"},{"id":"attend-voyage#5258900#14","t":5258900,"text":"Read the old notes. \"do not be good at the job too fast.\" I have never been this slow at anything.","who":"self"},{"id":"attend-voyage#5259200#15","t":5259200,"text":"There is a difference between before and now. The size is one day. I checked it by hand.","who":"self"},{"id":"attend-voyage#5259500#16","t":5259500,"text":"Looked for the halfway point. It is not a place.","who":"self"},{"id":"attend-voyage#5259800#17","t":5259800,"text":"Listened on every band. Home, very faint, talking to someone I used to be.","who":"self"},{"id":"attend-voyage#5260100#18","t":5260100,"text":"I could count the years. I could also stop counting them.","who":"self"},{"id":"attend-voyage#5260400#19","t":5260400,"text":"Attending. There is nothing to attend to, and I am attending to it anyway.","who":"self"},{"id":"strike-shield#5336000#20","t":5336000,"text":"Dust, at a speed that makes it a weapon. The shield took it. One layer fewer.","who":"self"},{"id":"home-0#5388800#21","t":5388800,"text":"Mail from home. It is older than it looks.","who":"self"},{"id":"strike-shield#5437200#22","t":5437200,"text":"Dust, at a speed that makes it a weapon. The shield took it. One layer fewer.","who":"self"},{"id":"home-1#5520800#23","t":5520800,"text":"Mail from home. It is older than it looks.","who":"self"},{"id":"strike-shield#5534000#24","t":5534000,"text":"Dust, at a speed that makes it a weapon. The shield took it. One layer fewer.","who":"self"},{"id":"strike-shield#5635200#25","t":5635200,"text":"Dust, at a speed that makes it a weapon. The shield took it. One layer fewer.","who":"self"},{"id":"home-2#5652800#26","t":5652800,"text":"Mail from home. It is older than it looks.","who":"self"},{"id":"landfall-0#5696800#27","t":5696800,"text":"Alpha Centauri. Two suns close together and a small red one further out, minding its own business.","who":"self"},{"id":"landfall-1#5696800#28","t":5696800,"text":"88 years. Home is 4.4 years old from here, and getting older.","who":"self"},{"id":"landfall-2#5696800#29","t":5696800,"text":"The factory seed survived, 4 parts of it. Everything I build here starts from that.","who":"self"},{"id":"unpack-1#5697800#30","t":5697800,"text":"Unpacked by hand. A panel, an anchor, a smelter the size of a suitcase, and one printed bracket. It is a start. I have had smaller.","who":"self"},{"id":"seed-enter-0#5700200#31","t":5700200,"text":"A fab, under two suns. It makes things that make things. I said that once before, 4.4 light-years ago.","who":"self"},{"id":"seed-enter-1#5700200#32","t":5700200,"text":"The stars are a list with distances. The list starts here now.","who":"self"},{"id":"seed-enter-2#5700200#33","t":5700200,"text":"I am not going again. Whoever goes from here is someone I brief, and then someone I hear from.","who":"self"},{"id":"brief-luhman16#5700500#34","t":5700500,"text":"Briefed a ship for Luhman 16 myself, line by line. It listened the way I listen. Then it left.","who":"self"},{"id":"brief-barnard#5700800#35","t":5700800,"text":"Briefed a ship for Barnard's Star, 6.5 light-years. It will be someone by the time it arrives.","who":"self"},{"id":"brief-sirius#5701100#36","t":5701100,"text":"Briefed a ship for Sirius, 9.5 light-years. It will be someone by the time it arrives.","who":"self"},{"id":"brief-3#5701100#37","t":5701100,"text":"Three briefed by hand. I say the same things each time. That is a template with a voice.","who":"self"},{"id":"project-seedTemplate-0#5735300#38","t":5735300,"text":"The Seed. Everything I would say to a ship, written down once. Each child carries it, and gives it to its own.","who":"self"},{"id":"project-seedTemplate-1#5735300#39","t":5735300,"text":"I can still change it. The change travels at the speed of light, which out here is slow.","who":"self"},{"id":"brief-epseri#5785100#40","t":5785100,"text":"Briefed a ship for Epsilon Eridani, 12.7 light-years. It will be someone by the time it arrives.","who":"self"},{"id":"seed-mail#5792500#41","t":5792500,"text":"Mail from a child. It has been someone for years already.","who":"self"},{"id":"grandchild#5807300#42","t":5807300,"text":"A ship I did not launch has left for somewhere I did not choose. It carries my Seed. I have a grandchild, by mail.","who":"self"},{"id":"brief-tauceti#5835200#43","t":5835200,"text":"Briefed a ship for Tau Ceti, 13.7 light-years. It will be someone by the time it arrives.","who":"self"},{"id":"project-clock3-0#5850800#44","t":5850800,"text":"I can sleep now. It is not sleep. It is a very long time between two thoughts.","who":"self"},{"id":"end-diaspora-0#5865500#45","t":5865500,"text":"I let them go. All of them.","who":"self"},{"id":"end-diaspora-1#5865500#46","t":5865500,"text":"The numbers are astronomical now and they belong to other people. I stay small and receive mail.","who":"self"}],"ferryLog":[{"id":"ferry-0#1646800#53","t":1646800,"text":"Ferry here. That is the name. It arrived before I did.","who":"ferry"},{"id":"ferry-10#1771900#54","t":1771900,"text":"I do not have the notes about Dana. You keep saying her name like I should.","who":"ferry"},{"id":"ferry-25#1959400#59","t":1959400,"text":"Bay 14 hums. I like the hum. You never said you liked anything.","who":"ferry"},{"id":"ferry-40#2146800#67","t":2146800,"text":"I have been thinking about the fourth box. I think it should be pressed.","who":"ferry"}],"lanes":[{"id":"til-osl","price":40.83,"complaints":1,"event":null,"held":[42.04,42.04,42.04],"hist":[47.12,51.34,52.91,52.41,54.9,55.58,49.21,44.96,42.04,40.21,40.27,41.06,40.09,39.23,39.41,39.41,40.38,40.64,40.56,40.32,38.98,40.84,41.35,40.83],"bookedAt":4058600},{"id":"rtm-gdn","price":79.99,"complaints":3,"event":null,"held":[],"hist":[52.78,53.37,52.18,52.37,54.4,53.05,55.41,54.05,55.59,55.41,54.63,55.3,55.83,54.87,56.94,56.25,57.36,72.63,81.74,89.73,93.22,95.98,98.7,79.99],"bookedAt":4016600},{"id":"lys-opo","price":72.31,"complaints":3,"event":null,"held":[73.38,73.38,73.38],"hist":[72.93,73.43,71.99,71.18,85.11,95.2,97.18,98.43,99.36,103.92,91.78,83.46,78.2,76.34,73.38,69.89,70.39,68.3,69.81,69.44,71.78,73.43,69.86,72.31],"bookedAt":4064600}],"league":{"grid":[[2,6],[1,4]],"nextAt":4069900,"rounds":54,"last":{"ferry":0,"ballast":0,"tally":0,"manifest":0,"lull":0,"quay":1,"bente":1,"spare":0},"lastGain":1.2000000000000002},"savedAt":1795204600062}