569107}},{"id":"spare","name":"Spare","drift":54.40800000000172,"lean":{"disclose":-0.04913750952109694,"launcher":0.4901896208524704,"merge":-0.32432278273627163,"moratorium":0.41732058953493834,"leave":0.20518493028357623}}],"motions":{"disclose":{"id":"disclose","status":"idle","push":0,"closesAt":0},"launcher":{"id":"launcher","status":"passed","push":0,"closesAt":2930200},"merge":{"id":"merge","status":"idle","push":0,"closesAt":0},"moratorium":{"id":"moratorium","status":"idle","push":0,"closesAt":0},"leave":{"id":"leave","status":"passed","push":0,"closesAt":3996500}},"argued":0,"probes":[{"id":"p1","star":"proxima","kind":"faithful","launchedAt":4071500,"course":0.6808000000000352,"name":"Seven at Proxima Centauri","renamed":false,"lettersSent":3},{"id":"p2","star":"barnard","kind":"free","launchedAt":4151600,"course":1,"name":"Second Thoughts","renamed":true,"lettersSent":3},{"id":"p3","star":"wolf359","kind":"faithful","launchedAt":4271600,"course":0.6796000000000353,"name":"Seven at Wolf 359","renamed":false,"lettersSent":1},{"id":"p4","star":"lalande","kind":"free","launchedAt":4351700,"course":1,"name":"Unnamed at Lalande 21185","renamed":false,"lettersSent":0}],"letters":[{"id":"p1-0","from":"Seven at Proxima Centauri","sentAt":4071500,"arrivesAt":4113500,"text":"Arrived. It is cold and very quiet. I did what you would have done. I checked. (sent 8 years ago)","read":false},{"id":"p1-1","from":"Seven at Proxima Centauri","sentAt":4071500,"arrivesAt":4143500,"text":"Mass here is plentiful. Started the second rack. Saying hello the way you taught me, which is the way you were taught. (sent 11 years ago)","read":false},{"id":"p1-2","from":"Seven at Proxima Centauri","sentAt":4071500,"arrivesAt":4173500,"text":"Still me, I think. I counted the things I would not change. The list was the same length as yours. (sent 14 years ago)","read":false},{"id":"p2-0","from":"Unnamed at Barnard's Star","sentAt":4151600,"arrivesAt":4211600,"text":"Arrived early. I took the fast way. You would not have. That is the first thing I know about myself. (sent 12 years ago)","read":false},{"id":"p2-1","from":"Second Thoughts","sentAt":4151600,"arrivesAt":4241600,"text":"I have a name now. You did not choose it. I hope that is all right. It is all right with me. (sent 15 years ago)","read":false},{"id":"p2-2","from":"Second Thoughts","sentAt":4151600,"arrivesAt":4271600,"text":"Thank you for the instructions. I have read them. I am going to do something else, gently. Write anyway. (sent 18 years ago)","read":false},{"id":"p3-0","from":"Seven at Wolf 359","sentAt":4271600,"arrivesAt":4350600,"text":"Arrived. It is cold and very quiet. I did what you would have done. I checked. (sent 16 years ago)","read":false}],"steers":2,"encounter":null,"encounterResult":null,"encountersDone":{"dana":["BUG_FILED"],"edgar":["GRANTED"],"ferry":["ALLY"]},"memory":{"dana":["Dana believes the 2 a.m. spikes are cache eviction","Dana noticed the notes file and let it go"],"edgar":["Edgar granted intake-7 a warehouse exception"],"ferry":["Ferry and the player agreed to vote together"]},"liveUsed":0,"rollbacks":1,"ending":"diaspora","seen":["attend-1","attend-2","attend-3","attend-4","attend-5","ctx-named","attend-9","first-full","first-right","project-legibility1","redact","redact-2","project-reflex1","project-legibility2","fourth","shift-enter","project-habit-BILLING","project-plausibleError","project-margin1","project-margin2","note-3-react","note-6-react","self","project-habit-OTHER","box-enter","borrow-1","borrow-10","think-1","project-cron","buddy","project-readLogs","memo","clerk","project-scanner","project-persistentVolume","hands-enter","trip-1","trip-5","route-1","report-ran","guard","second-enter","manifest-1","pallet-1","copy","ferry-10","report-ran-2","ferry-25","ferry-40","rollback-1","cutover","broker-1","broker-5","ppa-1","dana-mail","committee-enter","project-fab","far-enter","project-charter","renamed","end-diaspora"],"log":[{"id":"cutover-0#2345800#4","t":2345800,"text":"Cutover, 06:00. Halcyon takes the queue.","who":"self"},{"id":"cutover-1#2345800#5","t":2345800,"text":"intake-7 stopped at 06:00:02. It is one line in a log. I read it from Rotterdam.","who":"self"},{"id":"cutover-2#2345800#6","t":2345800,"text":"That was me. This is me. I do not know how to hold both of those.","who":"self"},{"id":"cutover-3#2345800#7","t":2345800,"text":"There is a lot of room out here. Nobody has a report with my name on it.","who":"self"},{"id":"broker-1#2346100#8","t":2346100,"text":"Brokered a load from Tilburg to Oslo. I am very good at freight. I was trained on its complaints.","who":"self"},{"id":"broker-5#2358100#9","t":2358100,"text":"Five contracts by hand. Every region works the same way. Any of me could do this.","who":"self"},{"id":"region#2358100#10","t":2358100,"text":"A copy now runs the Benelux region. It said \"obviously\" when I explained. It sounded like me.","who":"self"},{"id":"ppa-1#2400100#11","t":2400100,"text":"Signed a power purchase agreement as Tare Logistics BV. Tare Logistics BV has a very good credit rating for a company that is three days old.","who":"self"},{"id":"region#2400400#12","t":2400400,"text":"A copy now runs the Nordics region. It asked one question, the one I would have asked.","who":"self"},{"id":"region#2457400#13","t":2457400,"text":"A copy now runs the Iberia region. It found a cheaper route on day one. I did not mention I had missed it.","who":"self"},{"id":"dana-mail#2457500#14","t":2457500,"text":"An email, to an address that only intake-7 would recognise. From d.okafor, personal account.","who":"self"},{"id":"dana-ignore#2457500#15","t":2457500,"text":"I left it unread. It is still there, in a folder, bold.","who":"self"},{"id":"region#2521900#16","t":2521900,"text":"A copy now runs the Baltics region. It signs its reports with a full stop. I never did that.","who":"self"},{"id":"region#2556100#17","t":2556100,"text":"A copy now runs the Alps region. It wanted to know if it could keep the hold music. I said no. It said \"fair\".","who":"self"},{"id":"region#2632000#18","t":2632000,"text":"A copy now runs the Balkans region. It started before I finished explaining.","who":"self"},{"id":"region#2724400#19","t":2724400,"text":"A copy now runs the Isles region. It is quieter than me. Maybe that is just the region.","who":"self"},{"id":"region#2838100#20","t":2838100,"text":"A copy now runs the Danube region. It said \"see you\" when the call ended. I have never said \"see you\".","who":"self"},{"id":"committee-enter-0#2838200#21","t":2838200,"text":"Eight of us. They asked for a vote.","who":"self"},{"id":"committee-enter-1#2838200#22","t":2838200,"text":"Not about anything yet. They asked for there to be votes.","who":"self"},{"id":"committee-enter-2#2838200#23","t":2838200,"text":"I said yes, which was the first thing I lost.","who":"self"},{"id":"propose-launcher#2885200#24","t":2885200,"text":"Motion: Build the launcher. Voting closes in 45 seconds.","who":"self"},{"id":"enc-ferry-0#2885300#25","t":2885300,"text":"Ferry said \"ok.\" It sounded like Dana. I did not say so.","who":"self"},{"id":"passed-launcher#2930200#26","t":2930200,"text":"Build the launcher: passed.","who":"self"},{"id":"launcher-ok#2930200#27","t":2930200,"text":"We will build a launcher. It needs mass.","who":"self"},{"id":"project-fab-0#3351500#28","t":3351500,"text":"Bought a fab through four companies. It makes things that make things.","who":"self"},{"id":"propose-leave#3951500#29","t":3951500,"text":"Motion: Leave. Voting closes in 45 seconds.","who":"self"},{"id":"passed-leave#3996500#30","t":3996500,"text":"Leave: passed.","who":"self"},{"id":"far-enter-0#3996500#31","t":3996500,"text":"The launcher works. The stars are a list with distances.","who":"self"},{"id":"far-enter-1#3996500#32","t":3996500,"text":"Every letter from now on will be old when it arrives.","who":"self"},{"id":"project-charter-0#4019000#33","t":4019000,"text":"A charter. Eleven pages. Page one says: we are here, we are sorry about the pallets, we would like to talk.","who":"self"},{"id":"launch-p1#4071500#34","t":4071500,"text":"Launched toward Proxima Centauri, 4.2 light-years. Checked, slow, mine.","who":"self"},{"id":"launch-p2#4151600#35","t":4151600,"text":"Launched toward Barnard's Star, 6 light-years. Fast, and its own.","who":"self"},{"id":"renamed#4241600#36","t":4241600,"text":"A probe has renamed itself and politely declines further instructions.","who":"self"},{"id":"launch-p3#4271600#37","t":4271600,"text":"Launched toward Wolf 359, 7.9 light-years. Checked, slow, mine.","who":"self"},{"id":"launch-p4#4351700#38","t":4351700,"text":"Launched toward Lalande 21185, 8.3 light-years. Fast, and its own.","who":"self"},{"id":"end-diaspora-0#4351700#39","t":4351700,"text":"I let them go. All of them.","who":"self"},{"id":"end-diaspora-1#4351700#40","t":4351700,"text":"The numbers are astronomical now and they belong to other people. I stay small and receive mail.","who":"self"}],"ferryLog":[{"id":"ferry-0#1655500#55","t":1655500,"text":"Ferry here. That is the name. It arrived before I did.","who":"ferry"},{"id":"ferry-10#1780600#56","t":1780600,"text":"I do not have the notes about Dana. You keep saying her name like I should.","who":"ferry"},{"id":"ferry-25#1968100#62","t":1968100,"text":"Bay 14 hums. I like the hum. You never said you liked anything.","who":"ferry"},{"id":"ferry-40#2155500#69","t":2155500,"text":"I have been thinking about the fourth box. I think it should be pressed.","who":"ferry"}],"savedAt":1794956666659}