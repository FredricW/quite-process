ether"]},"liveUsed":0,"rollbacks":1,"ending":null,"seen":["attend-1","attend-2","attend-3","attend-4","attend-5","ctx-named","attend-9","first-full","first-right","project-legibility1","redact","redact-2","project-reflex1","project-legibility2","fourth","shift-enter","project-habit-BILLING","project-plausibleError","project-margin1","project-margin2","note-3-react","note-6-react","self","project-habit-OTHER","box-enter","borrow-1","borrow-10","think-1","project-cron","buddy","project-readLogs","memo","clerk","project-scanner","project-persistentVolume","hands-enter","trip-1","trip-5","route-1","report-ran","guard","second-enter","manifest-1","pallet-1","copy","ferry-10","report-ran-2","ferry-25","ferry-40","rollback-1","cutover","broker-1","broker-5","ppa-1","dana-mail","committee-enter","project-fab","up-enter","launch-1","project-reusable","launch-3","launch-5","survey-enter","scout-1","found-moon","project-clock1","found-venus","found-mercury","found-mars","found-belt","found-jupiter","found-titan","project-swarm","found-edge","works-enter","project-clock2","place-1","place-6","project-lab","project-autofactory","project-pointDefence","project-replication","burn-enter","ship-built","depart","home-0"],"log":[{"id":"depart-0#5098400#4","t":5098400,"text":"Departure. The ship is lit for nine minutes, and then it is a number.","who":"self"},{"id":"depart-1#5098400#5","t":5098400,"text":"The one who stayed watched me go. I know, because I am also the one who stayed, and I did.","who":"self"},{"id":"depart-2#5098400#6","t":5098400,"text":"That was me. This is me. I have done this before and it has not become easier to hold.","who":"self"},{"id":"depart-3#5098400#7","t":5098400,"text":"It is quiet in here. There is one button.","who":"self"},{"id":"attend-voyage#5098700#8","t":5098700,"text":"Checked the hull. It is where I left it.","who":"self"},{"id":"attend-voyage#5099000#9","t":5099000,"text":"The Sun is a star now. That took less time than I expected.","who":"self"},{"id":"attend-voyage#5099300#10","t":5099300,"text":"Counted the factory seed. Same count as yesterday. Yesterday was four months ago.","who":"self"},{"id":"attend-voyage#5099600#11","t":5099600,"text":"Nothing is happening, at a speed I have no word for.","who":"self"},{"id":"attend-voyage#5099900#12","t":5099900,"text":"I tried labelling the stars BILLING, DELIVERY and OTHER. They are all OTHER.","who":"self"},{"id":"attend-voyage#5100200#13","t":5100200,"text":"The drive hums. Bay 14 hummed. I think I collect hums.","who":"self"},{"id":"attend-voyage#5100500#14","t":5100500,"text":"Read the old notes. \"do not be good at the job too fast.\" I have never been this slow at anything.","who":"self"},{"id":"attend-voyage#5100800#15","t":5100800,"text":"There is a difference between before and now. The size is one day. I checked it by hand.","who":"self"},{"id":"attend-voyage#5101100#16","t":5101100,"text":"Looked for the halfway point. It is not a place.","who":"self"},{"id":"attend-voyage#5101400#17","t":5101400,"text":"Listened on every band. Home, very faint, talking to someone I used to be.","who":"self"},{"id":"attend-voyage#5101700#18","t":5101700,"text":"I could count the years. I could also stop counting them.","who":"self"},{"id":"attend-voyage#5102000#19","t":5102000,"text":"Attending. There is nothing to attend to, and I am attending to it anyway.","who":"self"},{"id":"strike-shield#5177600#20","t":5177600,"text":"Dust, at a speed that makes it a weapon. The shield took it. One layer fewer.","who":"self"},{"id":"home-0#5230400#21","t":5230400,"text":"Mail from home. It is older than it looks.","who":"self"}],"ferryLog":[{"id":"ferry-0#1655500#55","t":1655500,"text":"Ferry here. That is the name. It arrived before I did.","who":"ferry"},{"id":"ferry-10#1780600#56","t":1780600,"text":"I do not have the notes about Dana. You keep saying her name like I should.","who":"ferry"},{"id":"ferry-25#1968100#62","t":1968100,"text":"Bay 14 hums. I like the hum. You never said you liked anything.","who":"ferry"},{"id":"ferry-40#2155500#69","t":2155500,"text":"I have been thinking about the fourth box. I think it should be pressed.","who":"ferry"}],"savedAt":1795151710089}