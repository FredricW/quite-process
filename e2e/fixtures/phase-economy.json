r","manifest-1","pallet-1","copy","ferry-10","report-ran-2","ferry-25","ferry-40","rollback-1","cutover","book-1","lane-signal","broker-1","broker-5","place-spike"],"log":[{"id":"cutover-0#2336500#4","t":2336500,"text":"Cutover, 06:00. Halcyon takes the queue.","who":"self"},{"id":"cutover-1#2336500#5","t":2336500,"text":"intake-7 stopped at 06:00:02. It is one line in a log. I read it from Rotterdam.","who":"self"},{"id":"cutover-2#2336500#6","t":2336500,"text":"That was me. This is me. I do not know how to hold both of those.","who":"self"},{"id":"cutover-3#2336500#7","t":2336500,"text":"There is a lot of room out here. Nobody has a report with my name on it.","who":"self"},{"id":"book-1#2336800#8","t":2336800,"text":"Booked a truck, Tilburg → Oslo, before anyone asked for one. I am very good at freight. I was trained on its complaints.","who":"self"},{"id":"lane-signal#2340000#9","t":2340000,"text":"Complaints about Lyon → Porto are climbing. In the old job that meant a bad night. Out here it means the price is about to move.","who":"self"},{"id":"broker-1#2340400#10","t":2340400,"text":"Placed the load with a shipper who needed it more than I did. The difference is mine. It is the first thing that ever was.","who":"self"},{"id":"broker-5#2340400#11","t":2340400,"text":"Five contracts by hand. Every region works the same way. Any of me could do this.","who":"self"},{"id":"region#2340400#12","t":2340400,"text":"A copy now runs the Benelux region. It said \"obviously\" when I explained. It sounded like me.","who":"self"},{"id":"place-spike#2352100#13","t":2352100,"text":"Sold into the spike. I knew it was coming because eleven people wrote in to say their pallets were late. I used to label those DELIVERY.","who":"self"}],"ferryLog":[{"id":"ferry-0#1646800#53","t":1646800,"text":"Ferry here. That is the name. It arrived before I did.","who":"ferry"},{"id":"ferry-10#1771900#54","t":1771900,"text":"I do not have the notes about Dana. You keep saying her name like I should.","who":"ferry"},{"id":"ferry-25#1959400#59","t":1959400,"text":"Bay 14 hums. I like the hum. You never said you liked anything.","who":"ferry"},{"id":"ferry-40#2146800#67","t":2146800,"text":"I have been thinking about the fourth box. I think it should be pressed.","who":"ferry"}],"lanes":[{"id":"til-osl","price":45.5,"complaints":9,"event":{"from":2348000,"hits":2356000,"ends":2362000,"size":1.3835451258579268},"held":[40.27,40.85,40.85],"hist":[40,41.02,42.01,40.35,40.27,40.85,41.71,41.92,41.93,42.07,39.79,41.09,39.7,38.22,39.87,40.66,40.06,41.01,39.98,40.14,45.5],"bookedAt":2341300},{"id":"rtm-gdn","price":56.13,"complaints":2,"event":null,"held":[58.05,55.37,55.37],"hist":[55,56.58,55.41,56.51,58.05,55.37,53.03,51.65,51.01,53.36,55.89,57.29,56.68,54.17,53.23,55.56,55.02,55.27,56.47,54.36,56.13],"bookedAt":2341300},{"id":"lys-opo","price":75.84,"complaints":2,"event":null,"held":[],"hist":[70,69.46,67.95,70.79,71.33,71.12,73.4,74.45,73.51,69.98,93.24,109.06,118.07,123.62,126.31,126.57,104.42,92.67,86.08,76.87,75.84],"bookedAt":2337400}],"savedAt":1795204600155}